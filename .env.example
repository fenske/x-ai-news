# X Stock Sentinel - Environment Variables

# xAI API Key (Required)
# Get your API key from https://x.ai/api
XAI_API_KEY=your_xai_api_key_here

# Password Protection (Optional)
# To enable password protection, set a SHA-256 hash of your password
# Generate with: echo -n "your-password" | shasum -a 256
# Example for password "demo123": 2a97516c354b68848cdbd8f54a226a0a55b21ed138e207ad6c5cbb9c00aa5aea
PASSWORD_HASH=
